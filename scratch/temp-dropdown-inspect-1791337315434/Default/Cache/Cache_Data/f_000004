/* --------------------------------------------------------------------------
   KHỐI BÊN TRÁI: DANH SÁCH JOB (.split-list-pane)
   -------------------------------------------------------------------------- */
.split-list-pane {
  background: #FFFFFF;
  border: 1px solid #E2E8F0;
  border-radius: 20px;
  padding: 0;
  box-shadow: 0 4px 20px -4px rgba(15, 23, 42, 0.06);
  position: sticky;
  top: 145px;
  max-height: calc(100vh - 165px);
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  overflow: hidden;
}

/* Right List Header */
.split-list-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px 20px 14px 20px;
  background: #FFFFFF;
  border-bottom: 1px solid #E2E8F0;
  margin-bottom: 0;
  flex-shrink: 0;
  z-index: 2;
}

.split-list-title-group h3 {
  font-size: 16px;
  font-weight: 800;
  color: #0F172A;
  margin: 0 0 2px 0;
}

.split-list-count {
  font-size: 13px;
  color: #64748B;
}

.split-list-count strong {
  color: #F97316;
}

/* Right Scrollable Feed (Ẩn hoàn toàn scrollbar, phân tách các thẻ bằng rãnh màu nền) */
.split-list-feed {
  overflow-y: auto;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12px;
  padding: 12px 0 20px 0;
  background: #F1F5F9;
  scrollbar-width: none !important;
  -ms-overflow-style: none !important;
}

.split-list-feed::-webkit-scrollbar {
  display: none !important;
  width: 0 !important;
  height: 0 !important;
}

/* Compact Job Card inside Right Column (Bo góc mềm mại, viền sắc nét, nhận diện rõ rệt từng thẻ) */
.split-job-card {
  background: #FFFFFF;
  border: 1px solid #E2E8F0;
  border-left: 4px solid transparent;
  border-radius: 14px;
  padding: 14px 16px;
  cursor: pointer;
  transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1);
  display: flex;
  flex-direction: column;
  gap: 10px;
  position: relative;
  width: 100%;
  box-sizing: border-box;
  box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
  flex-shrink: 0;
  height: auto;
  min-height: fit-content;
}

.split-job-card:hover {
  background: #FFFFFF;
  border-color: #CBD5E1;
  border-left: 4px solid #FED7AA;
  border-radius: 14px;
  box-shadow: 0 4px 14px rgba(15, 23, 42, 0.08);
  transform: translateY(-2px);
  z-index: 1;
}

/* Card Active / Selected Highlight */
.split-job-card.is-selected {
  background: linear-gradient(90deg, #FFF7ED 0%, #FFFFFF 100%) !important;
  border: 1px solid #FED7AA !important;
  border-left: 5px solid #F97316 !important;
  border-radius: 14px !important;
  box-shadow: 0 3px 12px rgba(249, 115, 22, 0.12) !important;
  z-index: 2;
}

.split-job-card.is-selected .split-card-title a {
  color: #EA580C;
}

.split-active-badge {
  display: none !important;
}

.split-card-top {
  display: flex;
  gap: 14px;
  align-items: flex-start;
  flex-shrink: 0;
}

.split-company-logo {
  width: 81px;
  height: 81px;
  min-width: 81px;
  min-height: 81px;
  border-radius: 12px;
  border: 1px solid #E2E8F0;
  background: #FFFFFF;
  object-fit: contain;
  padding: 6px;
  box-sizing: border-box;
  flex-shrink: 0;
}

.split-card-info {
  flex: 1;
  min-width: 0;
}

.split-card-title {
  font-size: 14.5px;
  font-weight: 700;
  color: #0F172A;
  margin: 0 0 3px 0;
  line-height: 1.35;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.split-job-card.is-selected .split-card-title {
  color: #EA580C;
}

.split-card-company {
  font-size: 12.5px;
  color: #475569;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-bottom: 6px;
}

.split-card-badges {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 6px;
  font-size: 11.5px;
}

.split-card-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 2px;
  border-top: none;
  font-size: 12px;
  color: #64748B;
}

.split-card-location {
  display: inline-flex;
  align-items: center;
  gap: 4px;
}

/* Responsive Breakpoints */
@media (max-width: 1180px) {
  .job-split-container {
    grid-template-columns: 380px minmax(0, 1fr);
    gap: 16px;
  }
  .detail-metrics-grid {
