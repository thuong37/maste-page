}

.saved-filters-close,
.saved-filter-delete {
  width: 44px;
  height: 44px;
  flex: 0 0 44px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1px solid #E2E8F0;
  border-radius: 12px;
  background: #FFFFFF;
  color: #475569;
  cursor: pointer;
}

.saved-filters-close:hover,
.saved-filter-delete:hover {
  border-color: #FDBA74;
  background: #FFF7ED;
  color: #C2410C;
}

.saved-filters-body {
  overflow-y: auto;
  padding: 24px;
}

.saved-filter-create {
  padding: 20px;
  border: 1px solid #FED7AA;
  border-radius: 16px;
  background: #FFF7ED;
}

.saved-filter-section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
}

.saved-filter-section-heading h3 {
  font-size: 16px;
}

.saved-filter-current-summary {
  margin: 6px 0 0;
  color: #475569;
  font-size: 13px;
  line-height: 1.55;
}

#savedFilterForm {
  margin-top: 16px;
}

#savedFilterForm label {
  display: block;
  margin-bottom: 7px;
  color: #334155;
  font-size: 13px;
  font-weight: 700;
}

.saved-filter-form-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 10px;
}

#savedFilterName {
  min-width: 0;
  height: 44px;
  padding: 0 13px;
  border: 1px solid #CBD5E1;
  border-radius: 10px;
  background: #FFFFFF;
  color: #0F172A;
  font: inherit;
  font-size: 14px;
}

#savedFilterName[aria-invalid="true"] {
  border-color: #DC2626;
}

.saved-filter-submit,
.saved-filter-apply,
.saved-filter-delete-confirmation button {
  min-height: 44px;
  padding: 0 16px;
  border: 1px solid transparent;
  border-radius: 10px;
  font: inherit;
  font-size: 13px;
  font-weight: 700;
  cursor: pointer;
}

.saved-filter-submit,
.saved-filter-apply,
.saved-filter-confirm-delete {
  background: #F97316;
  color: #FFFFFF;
}

.saved-filter-submit:hover:not(:disabled),
.saved-filter-apply:hover,
.saved-filter-confirm-delete:hover {
  background: #EA580C;
}

.saved-filter-submit:disabled {
  background: #E2E8F0;
  color: #64748B;
  cursor: not-allowed;
}

.saved-filter-name-hint,
.saved-filter-error {
  margin: 7px 0 0;
  font-size: 12px;
  line-height: 1.45;
}

.saved-filter-name-hint {
  color: #64748B;
}

.saved-filter-error {
  color: #B91C1C;
  font-weight: 650;
}

.saved-filter-library {
  margin-top: 24px;
}

.saved-filter-library-count {
  color: #64748B;
  font-size: 12px;
  font-weight: 700;
}

.saved-filter-empty {
  margin-top: 14px;
  min-height: 150px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 24px;
  border: 1px dashed #CBD5E1;
  border-radius: 14px;
  background: #F8FAFC;
  color: #64748B;
  text-align: center;
}

.saved-filter-empty[hidden] {
  display: none;
}

.saved-filter-empty strong {
  color: #334155;
  font-size: 14px;
}

.saved-filter-empty span {
  font-size: 13px;
}

.saved-filter-list {
  display: grid;
  gap: 10px;
  margin: 14px 0 0;
  padding: 0;
  list-style: none;
}

.saved-filter-item {
  position: relative;
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: center;
  gap: 16px;
  padding: 15px;
  border: 1px solid #E2E8F0;
  border-radius: 14px;
  background: #FFFFFF;
}

.saved-filter-item-content {
  min-width: 0;
}

.saved-filter-item-content strong {
  display: block;
  overflow-wrap: anywhere;
  color: #0F172A;
  font-size: 14px;
}

.saved-filter-item-content p {
  margin: 5px 0 0;
  color: #64748B;
  font-size: 12px;
  line-height: 1.5;
}

.saved-filter-item-actions {
  display: flex;
  align-items: center;
  gap: 8px;
}

.saved-filter-delete-confirmation {
  grid-column: 1 / -1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8px;
  padding-top: 12px;
  border-top: 1px solid #FECACA;
  color: #991B1B;
  font-size: 13px;
  font-weight: 700;
}

.saved-filter-delete-confirmation button:not(.saved-filter-confirm-delete) {
  border-color: #CBD5E1;
  background: #FFFFFF;
  color: #334155;
}

.saved-filter-delete-confirmation .saved-filter-confirm-delete {
  background: #DC2626;
}

.btn-saved-filters:focus-visible,
.saved-filters-panel:focus-visible,
.saved-filters-close:focus-visible,
.saved-filter-submit:focus-visible,
.saved-filter-apply:focus-visible,
.saved-filter-delete:focus-visible,
.saved-filter-delete-confirmation button:focus-visible,
#savedFilterName:focus-visible {
  outline: 3px solid rgba(249, 115, 22, 0.42);
  outline-offset: 2px;
}

@media (max-width: 640px) {
  .btn-saved-filters {
    min-height: 44px;
  }

  .saved-filters-overlay {
    align-items: end;
    padding: 0;
  }

  .saved-filters-panel {
    width: 100%;
    max-height: min(88vh, 760px);
    border-radius: 20px 20px 0 0;
  }

  .saved-filters-header,
  .saved-filters-body {
    padding: 18px;
  }

  .saved-filter-create {
    padding: 16px;
  }

  .saved-filter-form-row,
  .saved-filter-item {
    grid-template-columns: 1fr;
  }

  .saved-filter-submit,
  .saved-filter-apply {
    width: 100%;
  }

  .saved-filter-item-actions {
    width: 100%;
  }

  .saved-filter-item-actions .saved-filter-apply {
    flex: 1;
  }

  .saved-filter-delete-confirmation {
    justify-content: stretch;
    flex-wrap: wrap;
  }

  .saved-filter-delete-confirmation span {
    width: 100%;
  }

  .saved-filter-delete-confirmation button {
    flex: 1;
  }
}

@media (prefers-reduced-motion: reduce) {
  .btn-saved-filters {
    transition: none;
  }
}

@media (prefers-color-scheme: dark) {
  .saved-filters-panel,
  .saved-filter-item,
  .saved-filters-close,
  .saved-filter-delete,
  #savedFilterName,
  .saved-filter-delete-confirmation button:not(.saved-filter-confirm-delete) {
    border-color: #475569;
    background: #0F172A;
    color: #F8FAFC;
  }

  .saved-filters-header,
  .saved-filter-delete-confirmation {
    border-color: #334155;
  }

  .saved-filter-create,
  .btn-saved-filters {
    border-color: #9A3412;
    background: #431407;
    color: #FDBA74;
  }

  .saved-filter-empty {
    border-color: #475569;
    background: #1E293B;
  }

  .saved-filters-header h2,
  .saved-filter-section-heading h3,
  .saved-filter-item-content strong,
  .saved-filter-empty strong {
    color: #F8FAFC;
  }

  .saved-filters-header > div > p:last-child,
  .saved-filter-current-summary,
  .saved-filter-item-content p,
  .saved-filter-library-count,
  .saved-filter-name-hint,
  .saved-filter-empty {
    color: #CBD5E1;
  }

  #savedFilterForm label {
    color: #E2E8F0;
  }
}
