{
  "name": "EasyCV Design Tokens",
  "version": "2.0.0",
  "style": {
    "visual": "structured, tokenized, content-first",
    "brand": "EasyCV"
  },
  "typography": {
    "fontFamily": {
      "primary": "Inter",
      "stack": "Inter, sans-serif",
      "sans": "Inter, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, sans-serif",
      "mono": "JetBrains Mono, monospace"
    },
    "metrics": {
      "baseSize": "14px",
      "baseWeight": 500,
      "baseLineHeight": "22px"
    },
    "scale": {
      "xs": "12px",
      "sm": "13px",
      "md": "14px",
      "lg": "15px",
      "xl": "16px",
      "2xl": "18px",
      "3xl": "20px"
    }
  },
  "spacing": {
    "scale": {
      "1": "2px",
      "2": "4px",
      "3": "5px",
      "4": "6px",
      "5": "8px",
      "6": "10px",
      "7": "11px",
      "8": "12px",
      "9": "16px",
      "10": "20px",
      "11": "24px",
      "12": "32px",
      "13": "40px",
      "14": "48px",
      "15": "64px"
    }
  },
  "radius": {
    "xs": "6px",
    "sm": "8px",
    "md": "10px",
    "lg": "22px",
    "xl": "32.29px",
    "2xl": "44px",
    "step7": "50px",
    "step8": "56px",
    "full": "9999px"
  },
  "shadow": {
    "1": "rgba(0, 0, 0, 0.1) 0px 0px 12px 0px",
    "card": "0 1px 3px 0 rgba(15, 23, 42, 0.05), 0 1px 2px -1px rgba(15, 23, 42, 0.05)",
    "cardHover": "0 8px 24px -4px rgba(249, 115, 22, 0.14), 0 4px 8px -2px rgba(15, 23, 42, 0.04)",
    "dropdown": "0 20px 25px -5px rgba(15, 23, 42, 0.1), 0 8px 10px -6px rgba(15, 23, 42, 0.08)"
  },
  "motion": {
    "durationInstant": "200ms",
    "timing": "cubic-bezier(0.16, 1, 0.3, 1)"
  },
  "colors": {
    "text": {
      "primary": "#1E293B",
      "secondary": "#475569",
      "tertiary": "#F97316",
      "inverse": "#64748B",
      "muted": "#94A3B8"
    },
    "surface": {
      "base": "#FFFFFF",
      "muted": "#F8FAFC",
      "raised": "#FFF7ED",
      "strong": "#F1F5F9"
    },
    "brand": {
      "primary": "#F97316",
      "primaryHover": "#EA580C",
      "primaryActive": "#C2410C",
      "primaryLight": "#FFF7ED",
      "primaryBorder": "#FED7AA",
      "secondary": "#0F172A"
    },
    "semantic": {
      "accent": "#16A34A",
      "border": "#E2E8F0"
    }
  }
}
